      "lines": [
        "/* returns TRAP_EN, EXCP_EN and EXCP_REPLACE. */",
        "static uint32_t kgd_gfx_v12_1_set_wave_launch_trap_override(struct amdgpu_device *adev,",
        "\t\t\t\t\tuint32_t vmid,",
        "\t\t\t\t\tuint32_t trap_override,",
        "\t\t\t\t\tuint32_t trap_mask_bits,",
        "\t\t\t\t\tuint32_t trap_mask_request,",
        "\t\t\t\t\tuint32_t *trap_mask_prev,",
        "\t\t\t\t\tuint32_t kfd_dbg_trap_cntl_prev)",
        "",
        "{",
        "\tuint32_t data = 0;",
        "",
        "\t*trap_mask_prev = trap_mask_map_hw_to_sw(kfd_dbg_trap_cntl_prev);",
        "",
        "\tdata = (trap_mask_bits & trap_mask_request) | (*trap_mask_prev & ~trap_mask_request);",
        "\tdata = trap_mask_map_sw_to_hw(data);",
        "",
        "\tdata = REG_SET_FIELD(data, SPI_GDBG_PER_VMID_CNTL, TRAP_EN, 1);",
        "\tdata = REG_SET_FIELD(data, SPI_GDBG_PER_VMID_CNTL, EXCP_REPLACE, trap_override);",
        "",
        "\treturn data;",
        "}",
        "",
        "/* returns STALL_VMID or LAUNCH_MODE. */",
        "static uint32_t kgd_gfx_v12_1_set_wave_launch_mode(struct amdgpu_device *adev,",
        "\t\t\t\t\tuint8_t wave_launch_mode,",
        "\t\t\t\t\tuint32_t vmid)"
      ]
    }
