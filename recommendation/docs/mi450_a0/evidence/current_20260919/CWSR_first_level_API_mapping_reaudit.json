        "/* Reserve space at top/bottom of address space for kernel use */",
        "#define AMDGPU_VA_RESERVED_CSA_SIZE\t\t(2ULL << 20)",
        "#define AMDGPU_VA_RESERVED_CSA_START(adev)\t(((adev)->vm_manager.max_pfn \\",
        "\t\t\t\t\t\t  << AMDGPU_GPU_PAGE_SHIFT)  \\",
        "\t\t\t\t\t\t - AMDGPU_VA_RESERVED_CSA_SIZE)",
        "#define AMDGPU_VA_RESERVED_SEQ64_SIZE\t\t(2ULL << 20)",
        "#define AMDGPU_VA_RESERVED_SEQ64_START(adev)\t(AMDGPU_VA_RESERVED_CSA_START(adev) \\",
        "\t\t\t\t\t\t - AMDGPU_VA_RESERVED_SEQ64_SIZE)",
        "#define AMDGPU_VA_RESERVED_TRAP_SIZE\t\t(1ULL << 16)",
        "#define AMDGPU_VA_RESERVED_TRAP_START(adev)\t(AMDGPU_VA_RESERVED_SEQ64_START(adev) \\",
        "\t\t\t\t\t\t - AMDGPU_VA_RESERVED_TRAP_SIZE)",
        "#define AMDGPU_VA_RESERVED_BOTTOM\t\t(1ULL << 16)",
        "#define AMDGPU_VA_RESERVED_TOP\t\t\t(AMDGPU_VA_RESERVED_TRAP_SIZE + \\",
        "\t\t\t\t\t\t AMDGPU_VA_RESERVED_SEQ64_SIZE + \\",
        "\t\t\t\t\t\t AMDGPU_VA_RESERVED_CSA_SIZE)"
      ]
