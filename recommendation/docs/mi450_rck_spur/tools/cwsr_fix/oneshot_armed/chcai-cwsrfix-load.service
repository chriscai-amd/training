# chcai MI450 A0 CWSR-handler test. Inert unless /var/lib/chcai-cwsrfix/ARMED exists; the loader
# deletes it, so the corrected amdgpu loads on one boot only. See /var/lib/chcai-cwsrfix/README.txt.
[Unit]
Description=chcai one-shot first load of the CWSR-corrected amdgpu
ConditionPathExists=/var/lib/chcai-cwsrfix/ARMED
After=local-fs.target systemd-udev-trigger.service systemd-modules-load.service
Before=spurd.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/var/lib/chcai-cwsrfix/load.sh

[Install]
WantedBy=multi-user.target
