        "static int amdgpu_debugfs_gem_info_show(struct seq_file *m, void *unused)",
        "{",
        "\tstruct amdgpu_device *adev = m->private;",
        "\tstruct drm_device *dev = adev_to_drm(adev);",
        "\tstruct drm_file *file;",
        "\tint r;",
        "",
        "\tr = mutex_lock_interruptible(&dev->filelist_mutex);",
        "\tif (r)",
        "\t\treturn r;",
        "",
        "\tlist_for_each_entry(file, &dev->filelist, lhead) {",
        "\t\tstruct task_struct *task;",
        "\t\tstruct drm_gem_object *gobj;",
        "\t\tstruct pid *pid;",
        "\t\tint id;",
        "",
        "\t\t/*",
        "\t\t * Although we have a valid reference on file->pid, that does",
        "\t\t * not guarantee that the task_struct who called get_pid() is",
        "\t\t * still alive (e.g. get_pid(current) => fork() => exit()).",
        "\t\t * Therefore, we need to protect this ->comm access using RCU.",
        "\t\t */",
        "\t\trcu_read_lock();",
        "\t\tpid = rcu_dereference(file->pid);",
        "\t\ttask = pid_task(pid,",
        "#ifdef HAVE_PIDTYPE_TGID",
        "\t\t\tPIDTYPE_TGID);",
        "#else",
        "\t\t\tPIDTYPE_PID);",
        "#endif",
        "\t\tseq_printf(m, \"pid %8d command %s:\\n\", pid_nr(pid),",
        "\t\t\t   task ? task->comm : \"<unknown>\");",
        "\t\trcu_read_unlock();",
        "",
        "\t\tspin_lock(&file->table_lock);",
        "\t\tidr_for_each_entry(&file->object_idr, gobj, id) {",
        "\t\t\tstruct amdgpu_bo *bo = gem_to_amdgpu_bo(gobj);",
        "",
        "\t\t\tamdgpu_bo_print_info(id, bo, m);",
        "\t\t}",
        "\t\tspin_unlock(&file->table_lock);",
        "\t}",
        "",
        "\tmutex_unlock(&dev->filelist_mutex);",
        "\treturn 0;",
        "}"
      ]
    },
