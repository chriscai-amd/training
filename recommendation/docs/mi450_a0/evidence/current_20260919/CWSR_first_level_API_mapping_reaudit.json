        "static int kfd_mmap(struct file *filep, struct vm_area_struct *vma)",
        "{",
        "\tstruct kfd_process *process;",
        "\tstruct kfd_process_device *pdd;",
        "\tstruct kfd_node *dev = NULL;",
        "\tunsigned long mmap_offset;",
        "\tunsigned int gpu_id;",
        "",
        "\tprocess = filep->private_data;",
        "\tif (!process)",
        "\t\treturn -ESRCH;",
        "",
        "\tif (process->lead_thread != current->group_leader)",
        "\t\treturn -EBADF;",
        "",
        "\tmmap_offset = vma->vm_pgoff << PAGE_SHIFT;",
        "\tgpu_id = KFD_MMAP_GET_GPU_ID(mmap_offset);",
        "",
        "\tpdd = kfd_process_device_data_by_id(process, gpu_id);",
        "\tif (pdd)",
        "\t\tdev = pdd->dev;",
        "",
        "\tswitch (mmap_offset & KFD_MMAP_TYPE_MASK) {",
        "\tcase KFD_MMAP_TYPE_DOORBELL:",
        "\t\tif (!dev)",
        "\t\t\treturn -ENODEV;",
        "\t\treturn kfd_doorbell_mmap(dev, process, vma);",
        "",
        "\tcase KFD_MMAP_TYPE_EVENTS:",
        "\t\tpr_warn(\"KFD_MMAP_TYPE_EVENTS is no longer supported\\n\");",
        "\t\treturn -EINVAL;",
        "",
        "\tcase KFD_MMAP_TYPE_RESERVED_MEM:",
        "\t\tpr_warn(\"KFD_MMAP_TYPE_RESERVED_MEM is no longer supported\\n\");",
        "\t\treturn -EINVAL;",
        "\tcase KFD_MMAP_TYPE_MMIO:",
        "\t\tif (!dev)",
        "\t\t\treturn -ENODEV;",
        "\t\treturn kfd_mmio_mmap(dev, process, vma);",
        "\t}",
        "",
        "\treturn -EFAULT;",
        "}"
      ]
    },
