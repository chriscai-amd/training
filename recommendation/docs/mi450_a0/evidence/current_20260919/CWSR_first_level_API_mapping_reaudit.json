        "\t\t\targs->va_addr, args->size, cpuva, mem_type, -1);",
        "\tif (idr_handle < 0) {",
        "\t\terr = -EFAULT;",
        "\t\tgoto err_free;",
        "\t}",
        "",
        "\t/* Update the VRAM usage count */",
        "\tif (flags & KFD_IOC_ALLOC_MEM_FLAGS_VRAM) {",
