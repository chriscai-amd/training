      "first_line": 3339,
      "lines": [
        "};",
        "",
        "static int __init amdgpu_init(void)",
        "{",
        "\tint r;",
        "",
        "\t/* Train lockdep on correct lock ordering */",
        "\tamdgpu_lockdep_init();",
        "",
        "\tr = amdgpu_sync_init();",
        "\tif (r)",
        "\t\treturn r;",
        "",
        "\tDRM_INFO(\"amdgpu version: %s\\n\", AMDGPU_VERSION);",
        "\tDRM_INFO(\"OS DRM version: %d.%d.%d\\n\", DRM_VER, DRM_PATCH, DRM_SUB);",
        "",
        "\tamdgpu_register_atpx_handler();",
        "\tamdgpu_acpi_detect();",
        "",
        "\t/* Ignore KFD init failures when CONFIG_HSA_AMD_AMDKCL is not set. */",
        "\tr = amdgpu_amdkfd_init();",
        "\tif (r && r != -ENOENT)",
        "\t\tgoto error_fini_sync;",
        "",
        "\tif (amdgpu_pp_feature_mask & PP_OVERDRIVE_MASK) {",
        "\t\tadd_taint(TAINT_CPU_OUT_OF_SPEC, LOCKDEP_STILL_OK);",
        "\t\tpr_crit(\"Overdrive is enabled, please disable it before \"",
        "\t\t\t\"reporting any bugs unrelated to overdrive.\\n\");",
        "\t}",
        "",
        "\t/* let modprobe override vga console setting */",
        "\treturn pci_register_driver(&amdgpu_kms_pci_driver);",
        "",
        "error_fini_sync:",
        "\tamdgpu_sync_fini();",
        "\treturn r;",
        "}",
        "",
        "static void __exit amdgpu_exit(void)",
        "{",
        "\tamdgpu_amdkfd_fini();",
        "\tpci_unregister_driver(&amdgpu_kms_pci_driver);",
        "\tamdgpu_unregister_atpx_handler();",
        "\tamdgpu_acpi_release();",
        "\tamdgpu_sync_fini();",
        "#ifdef HAVE_MMU_NOTIFIER_SYNCHRONIZE",
        "\tmmu_notifier_synchronize();",
        "#endif",
        "\tamdgpu_xcp_drv_release();",
        "",
        "\t/*",
        "\t * Flush outstanding call_rcu() callbacks before the",
        "\t * module text is freed.  Otherwise a grace period elapsing after",
        "\t * unload invokes a callback in already-freed module memory and",
        "\t * faults in rcu_do_batch().",
        "\t */",
        "\trcu_barrier();",
        "}",
        "",
        "module_init(amdgpu_init);",
        "module_exit(amdgpu_exit);",
        ""
      ]
    },
    {
      "source": {
        "path": "/home/chcai/mi450_logs/root_cause_20260919/session_20260921_CWSR_driver_build_v1/source/amd/amdkfd/kfd_device.c",
