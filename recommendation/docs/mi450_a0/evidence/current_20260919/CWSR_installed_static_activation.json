        "CWSR0xe0",
        "CWSR0x100",
        "CWSR0x10c",
        "CWSR0x118",
        "CWSR0x190"
      ]
    },
    {
      "scope": "context_save_fixup",
      "finding": "The first-level save path contains its own instruction fixup before clearing bank selections. Pure context save therefore need not execute the runtime second-level fixup to involve bank-history handling.",
      "evidence_offsets": [
        "CWSR0x470"
      ],
      "limitation": "Exact first-level decoder source/byte semantics are under separate independent review."
