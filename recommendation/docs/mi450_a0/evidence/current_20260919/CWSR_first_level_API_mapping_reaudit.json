        "static void kfd_cwsr_init(struct kfd_dev *kfd)",
        "{",
        "\tif (cwsr_enable && kfd->device_info.supports_cwsr) {",
        "\t\tif (KFD_GC_VERSION(kfd) < IP_VERSION(9, 0, 1)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx8_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx8_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx8_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) == IP_VERSION(9, 4, 1)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_arcturus_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_arcturus_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_arcturus_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) == IP_VERSION(9, 4, 2)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_aldebaran_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_aldebaran_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_aldebaran_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) == IP_VERSION(9, 4, 3) ||",
        "\t\t\t   KFD_GC_VERSION(kfd) == IP_VERSION(9, 4, 4)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx9_4_3_hex)",
