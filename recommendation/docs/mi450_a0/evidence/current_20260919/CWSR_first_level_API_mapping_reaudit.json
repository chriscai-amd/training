        "static int criu_checkpoint_bos(struct kfd_process *p,",
        "\t\t\t       uint32_t num_bos,",
        "\t\t\t       uint8_t __user *user_bos,",
        "\t\t\t       uint8_t __user *user_priv_data,",
        "\t\t\t       uint64_t *priv_offset)",
        "{",
        "\tstruct kfd_criu_bo_bucket *bo_buckets;",
        "\tstruct kfd_criu_bo_priv_data *bo_privs;",
        "\tstruct file **files = NULL;",
        "\tint ret = 0, pdd_index, bo_index = 0, id;",
        "\tstruct kfd_bo *buf_obj;",
        "",
        "\tbo_buckets = kvcalloc(num_bos, sizeof(*bo_buckets), GFP_KERNEL);",
        "\tif (!bo_buckets)",
        "\t\treturn -ENOMEM;",
        "",
        "\tbo_privs = kvcalloc(num_bos, sizeof(*bo_privs), GFP_KERNEL);",
        "\tif (!bo_privs) {",
        "\t\tret = -ENOMEM;",
        "\t\tgoto exit;",
        "\t}",
        "",
        "\tfiles = kvcalloc(num_bos, sizeof(struct file *), GFP_KERNEL);",
        "\tif (!files) {",
        "\t\tret = -ENOMEM;",
        "\t\tgoto exit;",
        "\t}",
        "",
        "\tfor (pdd_index = 0; pdd_index < p->n_pdds; pdd_index++) {",
        "\t\tstruct kfd_process_device *pdd = p->pdds[pdd_index];",
        "\t\tstruct amdgpu_bo *dumper_bo;",
        "\t\tstruct kgd_mem *kgd_mem;",
        "",
        "\t\tidr_for_each_entry(&pdd->alloc_idr, buf_obj, id) {",
        "\t\t\tstruct kfd_criu_bo_bucket *bo_bucket;",
        "\t\t\tstruct kfd_criu_bo_priv_data *bo_priv;",
        "\t\t\tint i, dev_idx = 0;",
        "",
        "\t\t\tkgd_mem = (struct kgd_mem *)buf_obj->mem;",
        "\t\t\tdumper_bo = kgd_mem->bo;",
        "",
        "\t\t\t/* Skip checkpointing BOs that are used for Trap handler",
        "\t\t\t * code and state. Currently, these BOs have a VA that",
        "\t\t\t * is less GPUVM Base",
        "\t\t\t */",
        "\t\t\tif (kgd_mem->va && kgd_mem->va <= pdd->gpuvm_base)",
        "\t\t\t\tcontinue;",
        "",
        "\t\t\tbo_bucket = &bo_buckets[bo_index];",
        "\t\t\tbo_priv = &bo_privs[bo_index];",
        "",
        "\t\t\tbo_bucket->gpu_id = pdd->user_gpu_id;"
      ]
