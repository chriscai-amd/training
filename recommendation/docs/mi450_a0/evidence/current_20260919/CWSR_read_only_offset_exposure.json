      "lines": [
        "void amdgpu_show_fdinfo(struct drm_printer *p, struct drm_file *file)",
        "{",
        "\tstruct amdgpu_fpriv *fpriv = file->driver_priv;",
        "\tstruct amdgpu_vm *vm = &fpriv->vm;",
        "",
        "\tstruct amdgpu_mem_stats stats[__AMDGPU_PL_NUM];",
        "\tktime_t usage[AMDGPU_HW_IP_NUM];",
        "\tconst char *pl_name[] = {",
        "\t\t[TTM_PL_VRAM] = \"vram\",",
        "\t\t[TTM_PL_TT] = \"gtt\",",
        "\t\t[TTM_PL_SYSTEM] = \"cpu\",",
        "\t\t[AMDGPU_PL_GDS] = \"gds\",",
        "\t\t[AMDGPU_PL_GWS] = \"gws\",",
        "\t\t[AMDGPU_PL_OA] = \"oa\",",
        "\t\t[AMDGPU_PL_DOORBELL] = \"doorbell\",",
        "\t\t[AMDGPU_PL_MMIO_REMAP] = \"mmioremap\",",
        "\t};",
        "\tunsigned int hw_ip, i;",
        "",
        "\tamdgpu_vm_get_memory(vm, stats);",
        "\tamdgpu_ctx_mgr_usage(&fpriv->ctx_mgr, usage);",
        "",
        "\t/*",
        "\t * ******************************************************************",
        "\t * For text output format description please see drm-usage-stats.rst!",
        "\t * ******************************************************************",
        "\t */",
        "",
        "\tdrm_printf(p, \"pasid:\\t%u\\n\", fpriv->vm.pasid);",
        "",
        "\tfor (i = 0; i < ARRAY_SIZE(pl_name); i++) {",
        "\t\tif (!pl_name[i])",
        "\t\t\tcontinue;",
        "",
        "\t\tdrm_print_memory_stats(p,",
        "\t\t\t\t       &stats[i].drm,",
        "\t\t\t\t       DRM_GEM_OBJECT_RESIDENT |",
        "\t\t\t\t       DRM_GEM_OBJECT_PURGEABLE,",
        "\t\t\t\t       pl_name[i]);",
        "\t}",
        "",
        "\t/* Legacy amdgpu keys, alias to drm-resident-memory-: */",
        "\tdrm_printf(p, \"drm-memory-vram:\\t%llu KiB\\n\",",
        "\t\t   stats[TTM_PL_VRAM].drm.resident/1024UL);",
        "\tdrm_printf(p, \"drm-memory-gtt: \\t%llu KiB\\n\",",
        "\t\t   stats[TTM_PL_TT].drm.resident/1024UL);",
        "\tdrm_printf(p, \"drm-memory-cpu: \\t%llu KiB\\n\",",
        "\t\t   stats[TTM_PL_SYSTEM].drm.resident/1024UL);",
        "",
        "\t/* Amdgpu specific memory accounting keys: */",
        "\tdrm_printf(p, \"amd-evicted-vram:\\t%llu KiB\\n\",",
        "\t\t   stats[TTM_PL_VRAM].evicted/1024UL);",
        "\tdrm_printf(p, \"amd-requested-vram:\\t%llu KiB\\n\",",
        "\t\t   (stats[TTM_PL_VRAM].drm.shared +",
        "\t\t    stats[TTM_PL_VRAM].drm.private) / 1024UL);",
        "\tdrm_printf(p, \"amd-requested-gtt:\\t%llu KiB\\n\",",
        "\t\t   (stats[TTM_PL_TT].drm.shared +",
        "\t\t    stats[TTM_PL_TT].drm.private) / 1024UL);",
        "",
        "\tfor (hw_ip = 0; hw_ip < AMDGPU_HW_IP_NUM; ++hw_ip) {",
        "#ifdef HAVE_KTIME_IS_UNION",
        "\t\tif (!usage[hw_ip].tv64)",
        "\t\t\tcontinue;",
        "#else",
        "\t\tif (!usage[hw_ip])",
        "\t\t\tcontinue;",
        "#endif",
        "",
        "\t\tdrm_printf(p, \"drm-engine-%s:\\t%lld ns\\n\", amdgpu_ip_name[hw_ip],",
        "\t\t\t   ktime_to_ns(usage[hw_ip]));",
        "\t}",
        "}"
      ]
    }
