      "lines": [
        "\t/* Validate virtual address range against reserved regions. */",
        "\tif (args->va_address < AMDGPU_VA_RESERVED_BOTTOM) {",
        "\t\tdev_dbg(dev->dev,",
        "\t\t\t\"va_address 0x%llx is in reserved area 0x%llx\\n\",",
        "\t\t\targs->va_address, AMDGPU_VA_RESERVED_BOTTOM);",
        "\t\treturn -EINVAL;",
        "\t}",
        "",
        "\tif (args->va_address >= AMDGPU_GMC_HOLE_START &&",
        "\t    args->va_address < AMDGPU_GMC_HOLE_END) {",
        "\t\tdev_dbg(dev->dev,",
        "\t\t\t\"va_address 0x%llx is in VA hole 0x%llx-0x%llx\\n\",",
        "\t\t\targs->va_address, AMDGPU_GMC_HOLE_START,",
        "\t\t\tAMDGPU_GMC_HOLE_END);",
        "\t\treturn -EINVAL;",
        "\t}",
        "",
        "\targs->va_address &= AMDGPU_GMC_HOLE_MASK;",
        "",
        "\tvm_size = adev->vm_manager.max_pfn * AMDGPU_GPU_PAGE_SIZE;",
        "\tvm_size -= AMDGPU_VA_RESERVED_TOP;",
        "\tif (check_add_overflow(args->va_address, args->map_size, &tmp) || tmp > vm_size) {",
        "\t\tdev_dbg(dev->dev,",
        "\t\t\t\"va_address 0x%llx is in top reserved area 0x%llx\\n\",",
        "\t\t\targs->va_address + args->map_size, vm_size);",
        "\t\treturn -EINVAL;",
        "\t}",
        ""
      ]
    },
