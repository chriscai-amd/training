        "\t\tmapping_flags |= AMDGPU_VM_PAGE_WRITEABLE;",
        "\tif (mem->alloc_flags & KFD_IOC_ALLOC_MEM_FLAGS_EXECUTABLE)",
        "\t\tmapping_flags |= AMDGPU_VM_PAGE_EXECUTABLE;",
        "",
        "\treturn mapping_flags;",
        "}",
