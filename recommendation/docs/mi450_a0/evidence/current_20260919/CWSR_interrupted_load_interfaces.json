        "\tstruct dma_fence *ef;",
        "\tstruct kfd_node *dev;",
        "\tint ret;",
        "",
        "\tif (pdd->drm_priv)",
        "\t\treturn -EBUSY;",
        "",
        "\tret = amdgpu_file_to_fpriv(drm_file, &drv_priv);",
        "\tif (ret)",
        "\t\treturn ret;",
        "\tavm = &drv_priv->vm;",
        "",
        "\tp = pdd->process;",
        "\tdev = pdd->dev;",
        "",
        "\tret = amdgpu_amdkfd_gpuvm_acquire_process_vm(dev->adev, avm,",
        "\t\t\t\t\t\t     &p->kgd_process_info,",
        "\t\t\t\t\t\t     p->ef ? NULL : &ef);",
        "\tif (ret) {",
        "\t\tdev_err(dev->adev->dev, \"Failed to create process VM object\\n\");",
        "\t\treturn ret;",
        "\t}",
        "",
        "\tif (!p->ef)",
        "\t\tRCU_INIT_POINTER(p->ef, ef);",
        "",
        "\tpdd->drm_priv = drm_file->private_data;",
        "",
        "\tret = kfd_process_device_reserve_ib_mem(pdd);",
        "\tif (ret)",
        "\t\tgoto err_reserve_ib_mem;",
        "\tret = kfd_process_device_init_cwsr_dgpu(pdd);",
        "\tif (ret)",
        "\t\tgoto err_init_cwsr;",
        "",
        "\tif (unlikely(!avm->pasid)) {",
        "\t\tdev_warn(pdd->dev->adev->dev, \"WARN: vm %p has no pasid associated\",",
        "\t\t\t\t avm);",
        "\t\tret = -EINVAL;",
        "\t\tgoto err_get_pasid;"
