        "static int kfd_ioctl_set_trap_handler(struct file *filep,",
        "\t\t\t\t\tstruct kfd_process *p, void *data)",
        "{",
        "\tstruct kfd_ioctl_set_trap_handler_args *args = data;",
        "\tint err = 0;",
        "\tstruct kfd_process_device *pdd;",
        "",
        "\tmutex_lock(&p->mutex);",
        "",
        "\tpdd = kfd_process_device_data_by_id(p, args->gpu_id);",
        "\tif (!pdd) {",
        "\t\terr = -EINVAL;",
        "\t\tgoto err_pdd;",
        "\t}",
        "",
        "\tpdd = kfd_bind_process_to_device(pdd->dev, p);",
        "\tif (IS_ERR(pdd)) {",
        "\t\terr = -ESRCH;",
        "\t\tgoto out;",
        "\t}",
        "",
        "\tkfd_process_set_trap_handler(&pdd->qpd, args->tba_addr, args->tma_addr);",
        "",
        "out:",
        "err_pdd:",
        "\tmutex_unlock(&p->mutex);",
        "",
        "\treturn err;",
        "}",
