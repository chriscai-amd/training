        "static int kfd_process_device_init_cwsr_dgpu(struct kfd_process_device *pdd)",
        "{",
        "\tstruct kfd_node *dev = pdd->dev;",
        "\tstruct qcm_process_device *qpd = &pdd->qpd;",
        "\tu32 flags = KFD_IOC_ALLOC_MEM_FLAGS_NO_SUBSTITUTE",
        "\t\t\t| KFD_IOC_ALLOC_MEM_FLAGS_EXECUTABLE;",
        "\tstruct kgd_mem *mem;",
        "\tvoid *kaddr;",
        "\tint ret;",
        "",
        "\tif (!dev->kfd->cwsr_enabled || qpd->cwsr_kaddr || !qpd->cwsr_base)",
        "\t\treturn 0;",
        "",
        "\tif (KFD_GC_VERSION(dev) >= IP_VERSION(9, 4, 2) && !dev->adev->apu_prefer_gtt)",
        "\t\tflags |= KFD_IOC_ALLOC_MEM_FLAGS_VRAM;",
        "\telse",
        "\t\tflags |= KFD_IOC_ALLOC_MEM_FLAGS_GTT;",
        "",
        "\t/* Allocate CWSR TBA/TMA buffers */",
        "\tret = kfd_process_alloc_gpuvm(pdd, qpd->cwsr_base,",
        "\t\t\t\t      KFD_CWSR_TBA_TMA_SIZE, flags, &mem, &kaddr);",
        "\tif (ret)",
        "\t\treturn ret;",
        "",
        "\tqpd->cwsr_mem = mem;",
        "\tqpd->cwsr_kaddr = kaddr;",
        "\tqpd->tba_addr = qpd->cwsr_base;",
        "",
        "\tmemcpy(qpd->cwsr_kaddr, dev->kfd->cwsr_isa, dev->kfd->cwsr_isa_size);",
        "",
        "\tkfd_process_set_trap_debug_flag(&pdd->qpd,",
        "\t\t\t\t\tpdd->process->debug_trap_enabled);",
        "",
        "\tqpd->tma_addr = qpd->tba_addr + KFD_CWSR_TMA_OFFSET;",
        "\tpr_debug(\"set tba :0x%llx, tma:0x%llx, cwsr_kaddr:%p for pqm.\\n\",",
        "\t\t qpd->tba_addr, qpd->tma_addr, qpd->cwsr_kaddr);",
        "",
        "\treturn 0;",
        "}",
        "",
        "static void kfd_process_device_destroy_cwsr_dgpu(struct kfd_process_device *pdd)",
        "{",
        "\tstruct kfd_node *dev = pdd->dev;",
        "\tstruct qcm_process_device *qpd = &pdd->qpd;",
        "",
        "\tif (!dev->kfd->cwsr_enabled || !qpd->cwsr_kaddr || !qpd->cwsr_base)",
        "\t\treturn;",
        "",
        "\tkfd_process_free_gpuvm(qpd->cwsr_mem, pdd, &qpd->cwsr_kaddr);",
        "}",
        "",
        "void kfd_process_set_trap_handler(struct qcm_process_device *qpd,",
        "\t\t\t\t  uint64_t tba_addr,",
        "\t\t\t\t  uint64_t tma_addr)",
        "{",
        "\tif (qpd->cwsr_kaddr) {",
        "\t\t/* KFD trap handler is bound, record as second-level TBA/TMA",
        "\t\t * in first-level TMA. First-level trap will jump to second.",
        "\t\t */",
        "\t\tuint64_t *tma =",
        "\t\t\t(uint64_t *)(qpd->cwsr_kaddr + KFD_CWSR_TMA_OFFSET);",
        "\t\ttma[0] = tba_addr;",
        "\t\ttma[1] = tma_addr;",
        "\t} else {",
        "\t\t/* No trap handler bound, bind as first-level TBA/TMA. */",
        "\t\tqpd->tba_addr = tba_addr;",
        "\t\tqpd->tma_addr = tma_addr;",
        "\t}",
        "}"
      ]
    },
