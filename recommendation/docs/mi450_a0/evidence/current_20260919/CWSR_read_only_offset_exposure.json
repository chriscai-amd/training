      "lines": [
        "}",
        "",
        "#if defined(CONFIG_DEBUG_FS)",
        "",
        "/* print the debug info for a specific set of status lists */",
        "static void amdgpu_debugfs_vm_bo_status_info(struct seq_file *m,",
        "\t\t\t\t\t     struct amdgpu_vm_bo_status *lists)",
        "{",
        "\tstruct amdgpu_vm_bo_base *base;",
        "\tunsigned int id;",
        "",
        "\tid = 0;",
        "\tseq_puts(m, \"\\tEvicted BOs:\\n\");",
        "\tlist_for_each_entry(base, &lists->evicted, vm_status) {",
        "\t\tif (!base->bo)",
        "\t\t\tcontinue;",
        "",
        "\t\tamdgpu_bo_print_info(id++, base->bo, m);",
        "\t}",
        "",
        "\tid = 0;",
        "\tseq_puts(m, \"\\tMoved BOs:\\n\");",
        "\tlist_for_each_entry(base, &lists->moved, vm_status) {",
        "\t\tif (!base->bo)",
        "\t\t\tcontinue;",
        "",
        "\t\tamdgpu_bo_print_info(id++, base->bo, m);",
        "\t}",
        "",
        "\tid = 0;",
        "\tseq_puts(m, \"\\tIdle BOs:\\n\");",
        "\tlist_for_each_entry(base, &lists->moved, vm_status) {",
        "\t\tif (!base->bo)",
        "\t\t\tcontinue;",
        "",
        "\t\tamdgpu_bo_print_info(id++, base->bo, m);",
        "\t}",
        "}",
        "",
        "/**",
        " * amdgpu_debugfs_vm_bo_info  - print BO info for the VM",
        " *",
        " * @vm: Requested VM for printing BO info",
        " * @m: debugfs file",
        " *",
        " * Print BO information in debugfs file for the VM",
        " */",
        "void amdgpu_debugfs_vm_bo_info(struct amdgpu_vm *vm, struct seq_file *m)",
        "{",
        "\tamdgpu_vm_assert_locked(vm);",
        "",
        "\tseq_puts(m, \"\\tKernel PT/PDs:\\n\");",
        "\tamdgpu_debugfs_vm_bo_status_info(m, &vm->kernel);",
        "",
        "\tseq_puts(m, \"\\tPer VM BOs:\\n\");",
        "\tamdgpu_debugfs_vm_bo_status_info(m, &vm->always_valid);",
        "",
        "\tseq_puts(m, \"\\tIndividual BOs:\\n\");",
        "\tspin_lock(&vm->individual_lock);",
        "\tamdgpu_debugfs_vm_bo_status_info(m, &vm->individual);",
        "\tspin_unlock(&vm->individual_lock);",
        "}",
        "#endif"
      ]
    },
