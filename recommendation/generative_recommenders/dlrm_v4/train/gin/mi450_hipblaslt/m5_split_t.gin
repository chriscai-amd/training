# !! UNTESTED ON A GPU. Run only as a guarded <=200-step A/B after the M5 GPU check kit
# !! (/home/chcai/m5_work/gpu_check: single GEMMs, then batched zero-DY) has passed.
# Overlay for docs/mi450_perf_opt.md (parsed after yambda_5b.gin via $DLRM_GIN_OVERLAY).
# Container paths: /armlibs = $LIBS of run_ab.sh (default /home/chcai/training_opt/arbor_libs, ro).
# M5 (variant s103): M1 lib swap with the v3 NT catalog (= T8 batch-1 pins + every M5 flattened
# batched key -> sol 103 MT256x128x64, 676 VGPRs: the A0 DW-corruption kernel) + split-T NT
# weight gradients for all six tall-K wgrads. M2/M3/M4 OFF (M3/M4 are exclusive with M5).
# Design: /home/chcai/m5_work/DESIGN.md. NT wgrad sol-103 variant; the sol-102 variant is
# m5_split_t_s102.gin.
apply_launch_env.hipblaslt_lib_dir = "/armlibs/rocm-10.2_nnonly_v3/s103"
apply_hipblaslt_opts.tuning_override_file = None
apply_hipblaslt_opts.tn_wgrad_hstu = False
apply_hipblaslt_opts.tn_wgrad_preproc = False
apply_hipblaslt_opts.splitt_wgrad_hstu = True
apply_hipblaslt_opts.splitt_wgrad_preproc = True
# key = hipBLASLt "MxN" of the NT wgrad = (width of b, width of a) in dW = a.t() @ b; value = s.
# G20 2048x512, G19 512x1536, G25 256x512, G29 1024x256, G31 512x256, G27 24x256.
# s must be one the s103 catalog pins (checked at import against the lib dir m5_splits.json; an
# unpinned s would land on 102, so import raises unless HSTU_SPLITT_ALLOW_UNPINNED=1):
# G20 {2,4,8,16} G19 {2,4,8,10,16,20} G25 {4..128} G29 {2..64} G31 {4..128} G27 {16..256}.
# Starting point = ~256 sol-103 workgroups (one per CU); the GPU bench picks the final values.
apply_hipblaslt_opts.splitt_wgrad_splits = {"2048x512": 8, "512x1536": 10, "256x512": 64, "1024x256": 32, "512x256": 64, "24x256": 128}
apply_hipblaslt_opts.splitt_min_rows = 4096
apply_hipblaslt_opts.splitt_audit_every = 0
