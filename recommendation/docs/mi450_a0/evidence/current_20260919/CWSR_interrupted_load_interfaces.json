      "first_line": 513,
      "lines": [
        "static void kfd_cwsr_init(struct kfd_dev *kfd)",
        "{",
        "\tif (cwsr_enable && kfd->device_info.supports_cwsr) {",
        "\t\tif (KFD_GC_VERSION(kfd) < IP_VERSION(9, 0, 1)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx8_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx8_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx8_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) == IP_VERSION(9, 4, 1)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_arcturus_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_arcturus_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_arcturus_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) == IP_VERSION(9, 4, 2)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_aldebaran_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_aldebaran_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_aldebaran_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) == IP_VERSION(9, 4, 3) ||",
        "\t\t\t   KFD_GC_VERSION(kfd) == IP_VERSION(9, 4, 4)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx9_4_3_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx9_4_3_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx9_4_3_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) == IP_VERSION(9, 5, 0)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx9_5_0_hex) > PAGE_SIZE);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx9_5_0_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx9_5_0_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) < IP_VERSION(10, 1, 1)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx9_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx9_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx9_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) < IP_VERSION(10, 3, 0)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_nv1x_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_nv1x_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_nv1x_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) < IP_VERSION(11, 0, 0)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx10_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx10_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx10_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) < IP_VERSION(12, 0, 0)) {",
        "\t\t\t/* The gfx11 cwsr trap handler must fit inside a single",
        "\t\t\t   page. */",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx11_hex) > PAGE_SIZE);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx11_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx11_hex);",
        "\t\t} else if (KFD_GC_VERSION(kfd) < IP_VERSION(12, 1, 0)) {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx12_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx12_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx12_hex);",
        "\t\t} else {",
        "\t\t\tBUILD_BUG_ON(sizeof(cwsr_trap_gfx12_1_0_hex)",
        "\t\t\t\t\t     > KFD_CWSR_TMA_OFFSET);",
        "\t\t\tkfd->cwsr_isa = cwsr_trap_gfx12_1_0_hex;",
        "\t\t\tkfd->cwsr_isa_size = sizeof(cwsr_trap_gfx12_1_0_hex);",
        "\t\t}",
        "",
        "\t\tkfd->cwsr_enabled = true;",
        "\t}",
        "}"
      ]
