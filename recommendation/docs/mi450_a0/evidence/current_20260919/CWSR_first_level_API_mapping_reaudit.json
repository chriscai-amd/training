        "static void kfd_init_apertures_v12(struct kfd_process_device *pdd, uint8_t id)",
        "{",
        "\tpdd->lds_base = pdd->dev->adev->gmc.shared_aperture_start;",
        "\tpdd->lds_limit = pdd->dev->adev->gmc.shared_aperture_end;",
        "",
        "\tpdd->gpuvm_base = AMDGPU_VA_RESERVED_BOTTOM;",
        "\tpdd->gpuvm_limit =",
        "\t\tpdd->dev->kfd->shared_resources.gpuvm_size - 1;",
        "",
        "\tpdd->scratch_base = pdd->dev->adev->gmc.private_aperture_start;",
        "\tpdd->scratch_limit = pdd->dev->adev->gmc.private_aperture_end;",
        "",
        "\t/*",
        "\t * Place TBA/TMA on opposite side of VM hole to prevent",
        "\t * stray faults from triggering SVM on these pages.",
        "\t */",
        "\tpdd->qpd.cwsr_base = AMDGPU_VA_RESERVED_TRAP_START(pdd->dev->adev);",
        "}"
      ]
    },
    {
