# Overlay for docs/mi450_perf_opt.md (parsed after yambda_5b.gin via $DLRM_GIN_OVERLAY).
# Container paths: /armlibs = <repo>/arbor_libs (ro), /opt/rocm-10.2 mounted (ro).
# M1 + T8: M1 lib swap with the v2 NT catalog, whose GridBased table pins the six tall-K NT weight
# gradients (G20/G19/G25/G29/G31/G27) to stock sol 103 MT256x128x64 at any jagged T.
# Sol 103 is the A0 DW-corruption kernel: on a driver with the faulty CWSR handler keep to guarded
# <=200-step A/Bs. Builder/report: docs/mi450_1P4G/ctheliosp-1b112-a37-1/hipBLASLt/t8_catalog/.
apply_launch_env.hipblaslt_lib_dir = "/armlibs/rocm-10.2_nnonly_v2"
apply_hipblaslt_opts.tuning_override_file = None
apply_hipblaslt_opts.tn_wgrad_hstu = False
apply_hipblaslt_opts.tn_wgrad_preproc = False
