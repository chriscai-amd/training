        "u64 amdgpu_bo_print_info(int id, struct amdgpu_bo *bo, struct seq_file *m)",
        "{",
        "\tstruct amdgpu_device *adev = amdgpu_ttm_adev(bo->tbo.bdev);",
        "\tstruct dma_buf_attachment *attachment;",
        "\tstruct dma_buf *dma_buf;",
        "\tconst char *placement;",
        "\tunsigned int pin_count;",
        "\tu64 size;",
        "",
        "\tif (dma_resv_trylock(amdkcl_ttm_resvp(&bo->tbo))) {",
        "\t\tif (!bo->tbo.resource) {",
        "\t\t\tplacement = \"NONE\";",
        "\t\t} else {",
        "\t\t\tswitch (bo->tbo.resource->mem_type) {",
        "\t\t\tcase TTM_PL_VRAM:",
        "\t\t\t\tif (amdgpu_res_cpu_visible(adev, bo->tbo.resource))",
        "\t\t\t\t\tplacement = \"VRAM VISIBLE\";",
        "\t\t\t\telse",
        "\t\t\t\t\tplacement = \"VRAM\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase TTM_PL_TT:",
        "\t\t\t\tplacement = \"GTT\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase AMDGPU_PL_GDS:",
        "\t\t\t\tplacement = \"GDS\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase AMDGPU_PL_GWS:",
        "\t\t\t\tplacement = \"GWS\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase AMDGPU_PL_OA:",
        "\t\t\t\tplacement = \"OA\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase AMDGPU_PL_PREEMPT:",
        "\t\t\t\tplacement = \"PREEMPTIBLE\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase AMDGPU_PL_DOORBELL:",
        "\t\t\t\tplacement = \"DOORBELL\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase AMDGPU_PL_MMIO_REMAP:",
        "\t\t\t\tplacement = \"MMIO REMAP\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase AMDGPU_PL_NPA:",
        "\t\t\t\tplacement = \"NPA\";",
        "\t\t\t\tbreak;",
        "\t\t\tcase TTM_PL_SYSTEM:",
        "\t\t\tdefault:",
        "\t\t\t\tplacement = \"CPU\";",
        "\t\t\t\tbreak;",
        "\t\t\t}",
        "\t\t}",
        "\t\tdma_resv_unlock(amdkcl_ttm_resvp(&bo->tbo));",
        "\t} else {",
        "\t\tplacement = \"UNKNOWN\";",
        "\t}",
        "",
        "\tsize = amdgpu_bo_size(bo);",
        "\tseq_printf(m, \"\\t\\t0x%08x: %12lld byte %s\",",
        "\t\t\tid, size, placement);",
        "",
        "\tpin_count = READ_ONCE(bo->tbo.pin_count);",
        "\tif (pin_count)",
        "\t\tseq_printf(m, \" pin count %d\", pin_count);",
        "",
        "\tdma_buf = READ_ONCE(bo->tbo.base.dma_buf);",
        "\tattachment = READ_ONCE(bo->tbo.base.import_attach);",
        "",
        "\tif (attachment)",
        "\t\tseq_printf(m, \" imported from ino:%llu\", file_inode(dma_buf->file)->i_ino);",
        "\telse if (dma_buf)",
        "\t\tseq_printf(m, \" exported as ino:%llu\", file_inode(dma_buf->file)->i_ino);",
        "",
        "\tamdgpu_bo_print_flag(m, bo, CPU_ACCESS_REQUIRED);",
        "\tamdgpu_bo_print_flag(m, bo, NO_CPU_ACCESS);",
        "\tamdgpu_bo_print_flag(m, bo, CPU_GTT_USWC);",
        "\tamdgpu_bo_print_flag(m, bo, VRAM_CLEARED);",
        "\tamdgpu_bo_print_flag(m, bo, VRAM_CONTIGUOUS);",
        "\tamdgpu_bo_print_flag(m, bo, VM_ALWAYS_VALID);",
        "\tamdgpu_bo_print_flag(m, bo, EXPLICIT_SYNC);",
        "\t/* Add the gem obj resv fence dump*/",
        "\tif (dma_resv_trylock(amdkcl_ttm_resvp(&bo->tbo))) {",
        "\t\tdma_resv_describe(amdkcl_ttm_resvp(&bo->tbo), m);",
        "\t\tdma_resv_unlock(amdkcl_ttm_resvp(&bo->tbo));",
        "\t} else {",
        "\t\tseq_puts(m, \"\\n\");",
        "\t}",
        "",
        "\treturn size;",
        "}"
      ]
    },
