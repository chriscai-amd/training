        "void kfd_process_set_trap_debug_flag(struct qcm_process_device *qpd,",
        "\t\t\t\t     bool enabled)",
        "{",
        "\tif (qpd->cwsr_kaddr) {",
        "\t\tvolatile unsigned long *tma =",
        "\t\t\t(volatile unsigned long *)(qpd->cwsr_kaddr + KFD_CWSR_TMA_OFFSET);",
        "\t\tif (enabled)",
        "\t\t\tset_bit(KFD_TRAP_TYPE_DEBUG, &tma[2]);",
        "\t\telse",
        "\t\t\tclear_bit(KFD_TRAP_TYPE_DEBUG, &tma[2]);",
        "\t}",
        "}",
        "",
        "void kfd_process_set_trap_pc_sampling_flag(struct qcm_process_device *qpd,",
        "\t\t\t\t     enum kfd_ioctl_pc_sample_method method, bool enabled)",
        "{",
        "\tif (qpd->cwsr_kaddr) {",
        "\t\tvolatile unsigned long *tma =",
        "\t\t\t(volatile unsigned long *)(qpd->cwsr_kaddr + KFD_CWSR_TMA_OFFSET);",
        "\t\tif (enabled)",
        "\t\t\tset_bit(method, &tma[2]);",
        "\t\telse",
        "\t\t\tclear_bit(method, &tma[2]);",
        "\t}",
        "}"
      ]
    },
