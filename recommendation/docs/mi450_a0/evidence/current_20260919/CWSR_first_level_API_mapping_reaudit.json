        "static int kfd_process_alloc_gpuvm(struct kfd_process_device *pdd,",
        "\t\t\t\t   uint64_t gpu_va, uint32_t size,",
        "\t\t\t\t   uint32_t flags, struct kgd_mem **mem, void **kptr)",
        "{",
        "\tstruct kfd_node *kdev = pdd->dev;",
        "\tint err;",
        "",
        "\terr = amdgpu_amdkfd_gpuvm_alloc_memory_of_gpu(kdev->adev, gpu_va, size,",
        "\t\t\t\t\t\t pdd->drm_priv, mem, NULL,",
        "\t\t\t\t\t\t flags, false);",
        "\tif (err)",
        "\t\tgoto err_alloc_mem;",
        "",
        "\terr = amdgpu_amdkfd_gpuvm_map_memory_to_gpu(kdev->adev, *mem,",
        "\t\t\tpdd->drm_priv);",
        "\tif (err)",
        "\t\tgoto err_map_mem;",
        "",
        "\terr = amdgpu_amdkfd_gpuvm_sync_memory(kdev->adev, *mem, true);",
        "\tif (err) {",
        "\t\tpr_debug(\"Sync memory failed, wait interrupted by user signal\\n\");",
        "\t\tgoto sync_memory_failed;",
        "\t}",
        "",
        "\tif (kptr) {",
        "\t\tu32 domain;",
        "",
        "\t\tif (flags & KFD_IOC_ALLOC_MEM_FLAGS_VRAM)",
        "\t\t\tdomain = AMDGPU_GEM_DOMAIN_VRAM;",
        "\t\telse",
        "\t\t\tdomain = AMDGPU_GEM_DOMAIN_GTT;",
        "\t\terr = amdgpu_amdkfd_gpuvm_map_bo_to_kernel((struct kgd_mem *)*mem,",
        "\t\t\t\t\t\t\t   kptr, NULL, domain);",
        "\t\tif (err) {",
        "\t\t\tpr_debug(\"Map BO to kernel failed err %d\\n\", err);",
        "\t\t\tgoto sync_memory_failed;",
        "\t\t}",
        "\t}",
        "",
        "\treturn err;",
        "",
        "sync_memory_failed:",
        "\tamdgpu_amdkfd_gpuvm_unmap_memory_from_gpu(kdev->adev, *mem, pdd->drm_priv);",
        "",
        "err_map_mem:",
        "\tamdgpu_amdkfd_gpuvm_free_memory_of_gpu(kdev->adev, *mem, pdd->drm_priv,",
        "\t\t\t\t\t       NULL);",
        "err_alloc_mem:"
      ]
